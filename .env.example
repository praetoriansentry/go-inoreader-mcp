# Copy to .env and fill in. NEVER commit .env.
# Register an app at https://www.inoreader.com/all_articles#preferences-developer
# (Inoreader > Preferences > Developer) and set the redirect URI to match below.

# Required: OAuth 2.0 client credentials for your registered Inoreader app.
INOREADER_CLIENT_ID=
INOREADER_CLIENT_SECRET=
# Alternative to the above: read the secret from a file (e.g. a Docker secret).
# INOREADER_CLIENT_SECRET_FILE=/run/secrets/inoreader_client_secret

# Must exactly match the redirect URI registered for the app.
INOREADER_REDIRECT_URI=http://localhost:8080/callback

# Where OAuth tokens are persisted (created by `inoreader-mcp auth login`).
# Default outside Docker: $XDG_CONFIG_HOME/inoreader-mcp/tokens.json
# In the container the image already defaults to /data/tokens.json (mount a
# volume at /data). Leave this unset for Docker, or keep it under /data; a
# relative path resolves against the container's working directory and is
# lost when the container exits.
# INOREADER_TOKEN_FILE=/data/tokens.json

# Optional: seed a refresh token without a token file (e.g. CI). The server
# still needs a writable INOREADER_TOKEN_FILE to persist rotated tokens.
# INOREADER_REFRESH_TOKEN=

# Disable every tool that modifies your account (mark read, star, subscribe...).
INOREADER_MCP_READ_ONLY=false

# Streamable HTTP transport (leave unset for stdio).
# INOREADER_MCP_HTTP_ADDR=127.0.0.1:8765
# Required when the HTTP listener is not bound to loopback. Generate with:
#   openssl rand -hex 32
# INOREADER_MCP_HTTP_TOKEN=

# debug | info | warn | error
INOREADER_MCP_LOG_LEVEL=info
