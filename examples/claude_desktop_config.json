{
  "mcpServers": {
    "inoreader": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "--env-file", "/absolute/path/to/go-inoreader-mcp/.env",
        "-v", "inoreader-data:/data",
        "--read-only", "--cap-drop", "ALL", "--security-opt", "no-new-privileges",
        "ghcr.io/praetoriansentry/go-inoreader-mcp:latest",
        "serve", "--read-only"
      ]
    }
  }
}
